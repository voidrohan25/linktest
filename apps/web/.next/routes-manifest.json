{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/attempts/[id]",
      "regex": "^/api/attempts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/attempts/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/attempts/[id]/answers",
      "regex": "^/api/attempts/([^/]+?)/answers(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/attempts/(?<nxtPid>[^/]+?)/answers(?:/)?$"
    },
    {
      "page": "/api/interviews/[id]",
      "regex": "^/api/interviews/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/interviews/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tests/take/[attemptId]",
      "regex": "^/tests/take/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/tests/take/(?<nxtPattemptId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/adaptive",
      "regex": "^/adaptive(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/adaptive(?:/)?$"
    },
    {
      "page": "/ai-interview",
      "regex": "^/ai\\-interview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai\\-interview(?:/)?$"
    },
    {
      "page": "/batches",
      "regex": "^/batches(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/batches(?:/)?$"
    },
    {
      "page": "/coding",
      "regex": "^/coding(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/coding(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/mock-tests",
      "regex": "^/mock\\-tests(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mock\\-tests(?:/)?$"
    },
    {
      "page": "/notifications",
      "regex": "^/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/notifications(?:/)?$"
    },
    {
      "page": "/plans",
      "regex": "^/plans(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/plans(?:/)?$"
    },
    {
      "page": "/progress",
      "regex": "^/progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/progress(?:/)?$"
    },
    {
      "page": "/results",
      "regex": "^/results(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/results(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}